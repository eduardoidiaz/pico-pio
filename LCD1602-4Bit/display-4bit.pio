.pio_version 0 // only requires PIO version 0

.program display

.side_set 1 opt    ; 1 side-set bit → E pin

.wrap_target
    out pins, 10        side 0   ; DB0–7 + RS + RW, E=0
    nop         [0]     side 0   ; setup (80ns)

    nop         [2]     side 1   ; E high (240ns)

    nop         [0]     side 0   ; E low (falling edge = latch)
    nop         [1]     side 0   ; hold

.wrap